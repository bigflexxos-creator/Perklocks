# Example environment configuration for backend/.env
# ---------------------------------------------------
# Copy to backend/.env and populate with real values.  Never commit
# actual keys or secrets — backend/.env is gitignored.

# Core Mongo + auth (do NOT modify in the deployed pod)
MONGO_URL=
DB_NAME=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# Third-party integrations (values managed in Emergent env config)
EMERGENT_LLM_KEY=
THE_ODDS_API_KEY=
SPORTDB_API_KEY=
SOCCER_API_KEY=
THESPORTSDB_KEY=
CFBD_API_KEY=
PROPLINE_API_KEY=
FOOTBALL_DATA_ORG_KEY=
OPENWEATHER_API_KEY=
API_SPORTS_KEY_1=
API_SPORTS_KEY_2=
API_SPORTS_KEY_3=

# ── Phase 2β: shared paid-credit budget (Odds API) ────────────────────
# Daily/monthly limits reset at 00:00 UTC.  Emergency reserve is only
# accessible for board-recovery scenarios via ProviderBudget policy.
ODDS_DAILY_CREDIT_LIMIT=
ODDS_MONTHLY_CREDIT_LIMIT=
ODDS_EMERGENCY_RESERVE=

# ── Phase 2γ: gateway + refresh-mode feature flags ────────────────────
# ODDS_GATEWAY_ENABLED — when true (default), every Odds API request
#   flows through services/odds_api_gateway.py.  When false, callers
#   fall back to the centralized cached provider path (odds_cache).
#   Budget, coordinator, and request-logging remain active in both
#   modes.  This flag is NOT a bypass for budget or lease checks.
ODDS_GATEWAY_ENABLED=

# ODDS_GLOBAL_REFRESH_MODE — controls the global full-board refresh.
#   Values:
#     snapshot       — 3× per day scheduled refresh + cold-start recovery
#                       (default; recommended)
#     legacy_hourly  — temporary emergency rollback; still uses
#                       JobCoordinator + ProviderBudget + gateway.
ODDS_GLOBAL_REFRESH_MODE=

# Miscellaneous
ODDS_PRIMARY_PROVIDER=
STARTUP_DEFER_SECONDS=
