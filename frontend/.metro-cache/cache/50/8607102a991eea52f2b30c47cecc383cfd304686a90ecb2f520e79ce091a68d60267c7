;\n      Object.entries(opts).forEach(([k, v]) => {\n        if (v != null && v !== \"\") params.set(k, String(v));\n      });\n      return request(`/lab/research/context?${params.toString()}`);\n    },\n    labResearchDistribution: (sport, subject, market_hint) => {\n      const p = new URLSearchParams({\n        sport,\n        subject\n      });\n      if (market_hint) p.set(\"market_hint\", market_hint);\n      return request(`/lab/research/distribution?${p.toString()}`);\n    },\n    labResearchLineExplorer: (sport, subject, line, market_hint) => {\n      const p = new URLSearchParams({\n        sport,\n        subject,\n        line: String(line)\n      });\n      if (market_hint) p.set(\"market_hint\", market_hint);\n      return request(`/lab/research/line-explorer?${p.toString()}`);\n    },\n    labResearchCalibration: sport => request(`/lab/research/calibration?sport=${encodeURIComponent(sport)}`),\n    labResearchPatterns: (sport, opts) => {\n      const p = new URLSearchParams({\n        sport\n      });\n      if (opts?.limit) p.set(\"limit\", String(opts.limit));\n      if (opts?.min_sample) p.set(\"min_sample\", String(opts.min_sample));\n      return request(`/lab/research/patterns?${p.toString()}`);\n    },\n    xgFormShadow: () => request(\"/analytics/xg-form-shadow\"),\n    picksToday: (sport, lineType, sortKey, filters, direction, extra) => {\n      const qs = new URLSearchParams();\n      if (sport && sport !== \"All\") qs.set(\"sport\", sport);\n      if (lineType && lineType !== \"both\") qs.set(\"line_type\", lineType);\n      // Always emit `sort` — the backend default is `time`, not `lock`, so\n      // omitting `sort=lock` silently flips us to chronological order and\n      // the \"Sort: Lock High→Low\" pill stops actually applying.\n      // (Bug 2026-06-26: \"filter by lock doesn't work, time/win pct do\".)\n      if (sortKey) qs.set(\"sort\", sortKey);\n      if (direction) qs.set(\"direction\", direction);\n      // ── New unified mu