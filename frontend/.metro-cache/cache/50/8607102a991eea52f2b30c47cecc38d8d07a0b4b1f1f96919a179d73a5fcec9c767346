ty}` + `&min_opportunity_rating=${minOpportunityRating}`),\n    // ── P4 · ONE ATD slate truth (Top 5 + By Game from the same universe) ──\n    nflAtdSlate: (minProbability = 0.10, topN = 5, topNPerGame = 3, extra) => request(`/nfl/atd/slate?min_probability=${minProbability}&top_n=${topN}&top_n_per_game=${topNPerGame}`, {\n      signal: extra?.signal\n    }),\n    nflGameSafeBets: (limit = 10, minProbability = 0.78) => request(`/nfl/games/safe-bets?limit=${limit}&min_probability=${minProbability}`),\n    nflTeamLeaderboard: (limit = 32) => request(`/nfl/games/teams?limit=${limit}`),\n    // ─── Session 5 · Universal Historical Intelligence 2.0 ─────────\n    // Lazy-loaded, market-aware historical actuals against today's\n    // EXACT sportsbook line.  Returns null summaries when data is\n    // genuinely missing — never zero-imputed.\n    historicalIntelligence: (pickId, opts = {}) => {\n      const p = new URLSearchParams();\n      if (opts.sampleScope) p.set(\"sample_scope\", opts.sampleScope);\n      if (opts.venueScope) p.set(\"venue_scope\", opts.venueScope);\n      if (opts.contextScope) p.set(\"context_scope\", opts.contextScope);\n      const qs = p.toString();\n      const suffix = qs ? `?${qs}` : \"\";\n      return request(`/picks/${pickId}/historical-intelligence${suffix}`);\n    }\n  };\n\n  // ─── NFL response types (shared with screens that render the cards) ───\n\n  // ─── Universal Historical Intelligence 2.0 (Session 5) ─────────────\n\n  // request/DB failure — client-side only, never \"no history\"\n});","lineCount":1200,"map":{"__version":1,"__count":6843,"__names":["exports","getBackendUrl","buildApiUrl","Object","defineProperty","enumerable","get","lastTruthManifest","noteTruthManifest","getToken","setToken","verifyAuthSingleFlight","api","_expoVirtualEnv","require","_dependencyMap","_srcUtilsStorage","_reactNativeWebDistExportsPlatform","Platform","_interopDefault","_expoConstants","Constants","_srcLibCanonicalEpoch","isLegacySgoPick","p","i