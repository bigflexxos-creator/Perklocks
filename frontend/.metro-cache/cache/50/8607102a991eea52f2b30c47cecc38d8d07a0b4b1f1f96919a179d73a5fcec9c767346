{min_lock}&sport=${encodeURIComponent(sport)}`),\n    nrfiYrfi: () => request(\"/picks/nrfi-yrfi\"),\n    refresh: () => request(\"/picks/refresh\", {\n      method: \"POST\"\n    }),\n    refreshStatus: () => request(\"/picks/refresh-status\"),\n    mlbLive: () => request(\"/mlb/live\"),\n    history: (days = 30, rolloverOnly = false) => request(`/picks/history?days=${days}${rolloverOnly ? \"&rollover_only=true\" : \"\"}`),\n    lossAnalysis: id => request(`/picks/${id}/loss-analysis`, {\n      method: \"POST\"\n    }),\n    triggerSettle: () => request(\"/picks/settle\", {\n      method: \"POST\"\n    }),\n    stats: () => request(\"/stats/summary\"),\n    // MLB HR slate (added 2026-06-30) — backs the new \"HR\" tab.\n    // Each game returns its weather/park/pitcher context plus up to 5\n    // top batter HR projections with full explainability bullets.\n    hrSlate: opts => {\n      const q = [];\n      if (opts?.date) q.push(`date=${encodeURIComponent(opts.date)}`);\n      if (opts?.refresh) q.push(\"refresh=true\");\n      // Cold slate builds take ~9-12s (Statcast + MLB Stats API + Open-Meteo\n      // fan-outs) so we lengthen the client timeout here from the default\n      // 10s to 30s. Warm cache hits return in <100ms so the 30s ceiling\n      // is basically only for the first request of the day.\n      return request(`/mlb/hr-slate${q.length ? \"?\" + q.join(\"&\") : \"\"}`, {\n        timeoutMs: 30_000\n      });\n    },\n    modelPerformance: () => request(\"/analytics/model-performance\"),\n    learnedWeights: () => request(\"/analytics/learned-weights\"),\n    learnNow: () => request(\"/analytics/learn\", {\n      method: \"POST\"\n    }),\n    analyticsV2: () => request(\"/analytics/v2\"),\n    analyticsV2Recompute: () => request(\"/analytics/v2/recompute\", {\n      method: \"POST\"\n    }),\n    // ── User Bets + Personal Analytics (2026-07-21) ─────────────────────\n    // User-scoped: server enforces `user_id == current_user.id` on every\n    /