 ({\n        ...r,\n        picks: dropLegacySgoPicks(r.picks || [])\n      }));\n    },\n    sportMarkets: sport => request(`/picks/markets/${encodeURIComponent(sport)}`),\n    picksAll: sport => request(`/picks/all${sport && sport !== \"All\" ? `?sport=${sport}` : \"\"}`),\n    // (Bet Killer endpoint removed — superseded by Under-of-the-Day.)\n    rollover: (lineType, filters, sport) => {\n      const qs = new URLSearchParams();\n      if (lineType && lineType !== \"both\") qs.set(\"line_type\", lineType);\n      if (sport && sport !== \"All\") qs.set(\"sport\", sport);\n      if (filters?.market) qs.set(\"market\", filters.market);\n      if (filters?.league) qs.set(\"league\", filters.league);\n      const q = qs.toString();\n      return request(`/picks/rollover${q ? `?${q}` : \"\"}`).then(r => ({\n        ...r,\n        picks: dropLegacySgoPicks(r.picks || [])\n      }));\n    },\n    underOfTheDay: (lineType, sortKey, filters, sport) => {\n      const qs = new URLSearchParams();\n      if (lineType && lineType !== \"both\") qs.set(\"line_type\", lineType);\n      if (sortKey && sortKey !== \"lock\") qs.set(\"sort\", sortKey);\n      if (sport && sport !== \"All\") qs.set(\"sport\", sport);\n      if (filters?.market) qs.set(\"market\", filters.market);\n      if (filters?.league) qs.set(\"league\", filters.league);\n      const q = qs.toString();\n      return request(`/picks/under-of-the-day${q ? `?${q}` : \"\"}`);\n    },\n    parlay: (legs = 3, mode = \"standard\", sport, lineType, includeSports = [], filters, rank = 1, lockedIds = [], sportMode = \"auto\", windowHours = 24, excludeSports = [], refreshNonce = 0, advancedSub) => {\n      const qs = new URLSearchParams({\n        legs: String(legs),\n        mode,\n        rank: String(rank),\n        sport_mode: sportMode,\n        window_hours: String(windowHours)\n      });\n      if (sportMode === \"single\" && sport && sport !== \"mix\") qs.set(\"sport\", sport);\n      if (sportMode === \"custom\" && includeSports.length > 0) {\n        qs.set(\"include_sports\", includeSports.join(\",\"));\n      }\n      if (sportMode === \"auto\" && excludeSports.length > 0) {\n        qs.set(\"exclude_sports\", excludeSports.join(\",\"));\n      }\n      if (lineType && lineType !== \"both\") qs.set(\"line_type\", lineType);\n      // Market filter only makes sense when the parlay is locked to one sport\n      // (sport_mode=single). For mixed/auto/custom modes, sending market=\n      // \"pitcher_strikeouts\" would filter every Soccer/Tennis/UFC pick out and\n      // leave the optimizer with only MLB — which is how the user's parlay\n      // tab ended up showing only one sport after a stale filter leaked in.\n      if (sportMode === \"single\" && filters?.market) qs.set(\"market\", filters.market);\n      if (sportMode === \"single\" && filters?.league) qs.set(\"league\", filters.league);\n      if (lockedIds.length > 0) qs.set(\"locked_ids\", lockedIds.join(\",\"));\n      if (refreshNonce > 0) qs.set(\"refresh_nonce\", String(refreshNonce));\n      if (mode === \"advanced\" && advancedSub) qs.set(\"advanced_sub\", advancedSub);\n      return request(`/picks/parlay?${qs.toString()}`);\n    },\n    pickDetail: id => request(`/picks/${id}`),\n    altLines: pickId => request(`/alt-lines/${pickId}`),\n    saveParlay: (legs, mode = \"standard\", stake = 1.0) => request(\"/parlay/save\", {\n      method: \"POST\",\n      body: {\n        legs,\n        mode,\n        stake\n      }\n    }),\n    parlayHistory: filter => {\n      const qs = filter && filter !== \"all\" ? `?filter=${filter}` : \"\";\n      return request(`/parlay/history${qs}`);\n    },\n    deleteParlay: id => request(`/parlay/${id}`, {\n      method: \"DELETE\"\n    }),\n    resettleParlay: id => request(`/parlay/${id}/resettle`, {\n      method: \"POST\"\n    }),\n    pickAiExplain: id => request(`/picks/${id}/ai-explain`, {\n      method: \"POST\"\n    }),\n    pickSimulation: id => request(`/picks/${id}/simulation`),\n    pickEvidenceInspector: id => request(`/admin/pick-evidence/${id}`),\n    pitcherH2H: id => request(`/picks/${id}/pitcher-h2h`),\n    // Player-vs-Opponent Matchup Intelligence (2026-07-28) — historical\n    // performance grade against this specific opponent. See\n    // `services/pick_matchup_wiring.py` for the payload contract.\n    pickMatchup: id => request(`/picks/${id}/matchup`),\n    // Unified H2H bundle (2026-02) — used by the deep-dive `/pick/[id]` screen.\n    h2h: id => request(`/picks/${id}/h2h`),\n    simBacktest: (days = 30, sport) => request(`/analytics/sim-backtest?days=${days}${sport ? `&sport=${encodeURIComponent(sport)}` : \"\"}`),\n    pickCoverage: (id, cohort = \"teammates\") => request(`/picks/${id}/coverage?cohort=${cohort}`),\n    pickLockBreakdown: id => request(`/picks/${id}/lock-breakdown`),\n    pickMarketRank: id => request(`/picks/${id}/market-rank`),\n    pickScorerBundles: id => request(`/picks/${id}/scorer-bundles`),\n    soccerLabLeagues: (refresh = false) => request(`/soccer-lab/leagues${refresh ? \"?refresh=true\" : \"\"}`),\n    soccerLabFeed: (limit = 50, min_lock = 78, sport = \"Soccer\") => request(`/soccer-lab/feed?limit=${limit}&min_lock=${min_lock}&sport=${encodeURIComponent(sport)}`),\n    nrfiYrfi: () => request(\"/picks/nrfi-yrfi\"),\n    refresh: () => request(\"/picks/refresh\", {\n      method: \"POST\"\n    }),\n    refreshStatus: () => request(\"/picks/refresh-status\"),\n    mlbLive: () => request(\"/mlb/live\"),\n    history: (days = 30, rolloverOnly = false) => request(`/picks/history?days=${days}${rolloverOnly ? \"&rollover_only=true\" : \"\"}`),\n    lossAnalysis: id => request(`/picks/${id}/loss-analysis`, {\n      method: \"POST\"\n    }),\n    triggerSettle: () => request(\"/picks/settle\", {\n      method: \"POST\"\n    }),\n    stats: () => request(\"/stats/summary\"),\n    // MLB HR slate (added 2026-06-30) — backs the new \"HR\" tab.\n    // Each game returns its weather/park/pitcher co