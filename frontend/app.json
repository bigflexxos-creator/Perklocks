{
  "expo": {
    "name": "PerkLocks",
    "slug": "perkslocks",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Access photos to attach to your bet slip.",
        "NSPhotoLibraryAddUsageDescription": "Save betslip images to your Photos to share."
      },
      "bundleIdentifier": "app.emergent.betedgeai11ae77c4f"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.emergent.betedgeai.c7c4p1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-bg-v7.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Access photos to attach to your bet slip.",
          "savePhotosPermission": "Save betslip images to your Photos to share.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
