  "live_db_access": false,
  "accepted_filename_patterns": {
    "preferred": [
      "<collection>.json",
      "<collection>_part1.json",
      "<collection>_part2.json",
      "<collection>_part<N>.json"
    ],
    "also_accepted": [
      "<collection>.json.gz",
      "<collection>_part<N>.json.gz",
      "<collection>.ndjson",
      "<collection>_part<N>.ndjson",
      "<collection>.ndjson.gz",
      "<collection>_part<N>.ndjson.gz",
      "<collection>_slim.json",
      "<collection>_slim_part<N>.json"
    ],
    "completion_sentinel": "<collection>.complete.json  (JSON: {\"total_parts\": N})  \u2014 ONLY required when production_count_known is null in this manifest",
    "rules": [
      "Original Production export files MUST NOT be modified.",
      "Slim-projection is OPTIONAL. The reconciliation engine projects internally.",
      "Multipart part numbers must start at 1 and be contiguous (no gaps).",
      ".gz is optional; it is NOT required.",
      "A single file \u2018<collection>.json\u2019 by itself counts as complete for that collection."
    ]
  },
  "collection_ready_rules": [
    "A collection is READY when either (a) exactly one standalone file \u2018<collection>.json\u2019 has been ingested, OR (b) all parts 1..N have been received contiguously AND, if \u2018production_count_known\u2019 is set in this manifest, sum(part.doc_count) == production_count_known, OR (c) a \u2018<collection>.complete.json\u2019 sentinel is received after multipart ingest.",
    "A collection is BLOCKED if \u2018duplicate_ids_across_parts\u2019 > 0.",
    "A collection is BLOCKED if any part has \u2018status\u2019 != INGESTED.",
    "The full reconciliation dry-run runs ONLY after every REQUIRED_FULL_DATA collection is READY."
  ],
  "upload_phases": [
